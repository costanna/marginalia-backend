# Copy to .env and adjust. NEVER commit .env or real values.

# --- Local PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=marginalia
POSTGRES_PASSWORD=marginalia
POSTGRES_DB=marginalia
# Host port published by Docker. Change it (and the port in DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432

# --- Application ---
# Driver prefix must be postgresql+psycopg. On Neon, use the "pooled" string with ?sslmode=require
DATABASE_URL=postgresql+psycopg://marginalia:marginalia@localhost:5432/marginalia
# Generate a long random value: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-random-string-of-64-or-more-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200
ENVIRONMENT=development

# --- LLM (this project is designed to run at ZERO cost) ---
# fake              = offline deterministic client: free, no key, only knows a few common mistakes
#                     (development and tests).
# openai_compatible = any provider that speaks the OpenAI chat protocol, INCLUDING FREE TIERS.
#                     Requires LLM_BASE_URL, LLM_API_KEY and LLM_MODEL. Examples (verify the
#                     current URL, model names and free limits in each provider's docs; model
#                     names change often: list the ones your key can use with
#                     `curl -H "Authorization: Bearer $LLM_API_KEY" $LLM_BASE_URL/models`):
#                       Groq   https://api.groq.com/openai/v1   model: openai/gpt-oss-120b
#                       Gemini https://generativelanguage.googleapis.com/v1beta/openai
# anthropic         = Anthropic API (paid, optional). Requires LLM_API_KEY and LLM_MODEL.
LLM_PROVIDER=fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096

# --- Limits ---
DAILY_ANALYSIS_LIMIT=10
DAILY_GENERATION_LIMIT=5
DEMO_DAILY_LIMIT=3
MAX_TEXT_CHARS=3000
# A ceiling on every LLM call made by anyone, all users and the demo combined, per day: protects
# a free-tier provider key (e.g. Groq's 1000 requests/day) from being exhausted by real usage
# before the day resets. Set comfortably under the provider's own daily limit.
DAILY_GLOBAL_LLM_LIMIT=900
# Reverse proxies in front of the API that append to X-Forwarded-For (0 locally). Measure it on
# the real host with GET /api/v1/diagnostics/client-ip (see the README) rather than guessing: on
# Render it is 3 (Cloudflare, then Render's own balancer, in front of the visitor's own address).
TRUSTED_PROXY_HOPS=0
