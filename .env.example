# Copy to .env and adjust. NEVER commit .env or real values.

# --- Local PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=marginalia
POSTGRES_PASSWORD=marginalia
POSTGRES_DB=marginalia
# Host port published by Docker. Change it (and the port in DATABASE_URL) if 5432 is taken.
POSTGRES_PORT=5432

# --- Application ---
# Driver prefix must be postgresql+psycopg. On Neon, use the "pooled" string with ?sslmode=require
DATABASE_URL=postgresql+psycopg://marginalia:marginalia@localhost:5432/marginalia
# Generate a long random value: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-with-a-random-string-of-64-or-more-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:4200
ENVIRONMENT=development

# --- LLM ---
# fake = deterministic client, no cost (development and tests); anthropic = real API
LLM_PROVIDER=fake
LLM_API_KEY=
# Required when LLM_PROVIDER=anthropic. A fast, cheap model is enough to start, e.g. claude-haiku-4-5
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=4096

# --- Limits ---
DAILY_ANALYSIS_LIMIT=10
DEMO_DAILY_LIMIT=3
MAX_TEXT_CHARS=3000
# Reverse proxies in front of the API that append to X-Forwarded-For (0 locally). On a host
# behind one proxy (e.g. Render) set 1, or every visitor would look like the proxy's IP.
TRUSTED_PROXY_HOPS=0
